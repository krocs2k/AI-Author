
generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// User Authentication Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(USER)
  isApproved    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  bookSessions  BookSession[]
  folders       Folder[]
  usageLogs     LLMUsageLog[]
}

model Folder {
  id        String        @id @default(cuid())
  name      String
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?       @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[]      @relation("FolderTree")
  sessions  BookSession[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([userId])
  @@index([parentId])
}

model LLMUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId        String?
  taskType         String
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostUsd Float    @default(0)
  cacheHit         Boolean  @default(false)
  durationMs       Int?
  createdAt        DateTime @default(now())
  @@index([createdAt])
  @@index([userId])
  @@index([sessionId])
  @@index([taskType])
}

model PromptCache {
  id               String    @id @default(cuid())
  cacheKey         String    @unique
  taskType         String
  model            String
  systemPrompt     String    @db.Text
  userPrompt       String    @db.Text
  response         String    @db.Text
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  hitCount         Int       @default(0)
  lastHitAt        DateTime?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  @@index([taskType, model])
  @@index([hitCount])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Google SSO Dynamic Configuration
model GoogleSSOConfig {
  id           String   @id @default(cuid())
  clientId     String
  clientSecret String
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

// LLM API Configuration
model LLMConfig {
  id                  String   @id @default(cuid())
  
  // API Keys (encrypted at rest by DB)
  abacusApiKey        String?
  geminiApiKey        String?
  
  // Active provider selection
  activeProvider      String   @default("abacus") // "abacus" or "gemini"
  
  // Model selections
  ideaModel           String?  // Model ID for idea generation (synopsis, titles, genre analysis)
  writingModel        String?  // Model ID for story writing (content, chapters)
  
  // Cached available models (JSON arrays)
  abacusModels        Json?    // Cached list of Abacus.AI models
  geminiModels        Json?    // Cached list of Gemini models
  
  // Last refresh timestamps
  abacusModelsRefreshedAt DateTime?
  geminiModelsRefreshedAt  DateTime?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BookSession {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // User relationship
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Folder organization
  folderId          String?
  folder            Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name              String?  // User-friendly book name/title for saved books
  
  // Genre Selection
  selectedGenre     String?
  genreAnalysis     Json?    // MojoSauce analysis
  authorAnalysis    Json?    // SecretSauce analysis
  
  // Synopsis Generation
  customTopic       String?
  selectedSynopsis  String?
  synopses          Json?    // Array of generated synopses
  
  // Title & Planning
  selectedTitle     String?
  customTitle       String?
  generatedTitles   Json?    // Array of generated titles
  plannedChapters   Int?
  wordsPerChapter   Int?
  
  // Content Creation
  forward           String?  // Forward/intro content
  forwardWordCount  Int?
  chapters          Chapter[]
  
  // Marketing Assets
  coverPrompts      Json?    // Front and back cover prompts
  salesCopy         String?
  backCoverCopy     String?
  
  // Metrics
  totalWordCount    Int?     @default(0)
  estimatedReadTime Int?     @default(0)
  humanizationScore Float?   @default(0)
  successProbability Float?  @default(0)
  
  // Progress Tracking
  currentStep       Int      @default(1)
  completedSteps    Json?    // Array of completed step numbers
}

model Chapter {
  id            String      @id @default(cuid())
  sessionId     String
  session       BookSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  chapterNumber Int
  title         String?
  content       String?
  wordCount     Int?        @default(0)
  humanizationScore Float?  @default(0)
  generatedAt   DateTime?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@unique([sessionId, chapterNumber])
}
